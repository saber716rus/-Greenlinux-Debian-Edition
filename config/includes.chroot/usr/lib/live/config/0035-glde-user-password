#!/bin/sh

. /usr/lib/live/config.sh

## live-config(7) - System Configuration Components
##
## GLDE: пароль live-пользователя glde — 'glde'.
## Штатный компонент 0030-user-setup задаёт захардкоженный пароль 'live'
## для любого username (параметра user-password= в live-config нет).
## Этот компонент выполняется после создания пользователя и меняет пароль.

Init ()
{
	# Уже выполнен?
	if component_was_executed "glde-user-password"
	then
		exit 0
	fi

	# Пользователь должен быть уже создан (компонент 0030-user-setup)
	if [ ! -e /var/lib/live/config/user-setup ]
	then
		exit 0
	fi

	echo -n " glde-user-password"
}

Config ()
{
	if grep -q "^glde:" /etc/passwd
	then
		echo "glde:glde" | chpasswd
	fi

	# Создаём state-файл
	touch /var/lib/live/config/glde-user-password
}

Cmdline ()
{
	true
}

Cmdline
Init
Config
