# GLDE Cinnamon/slick-greeter defaults.
# Адаптация mint-artwork.gschema.override из visual-gl (Green Linux)
# для LMDE-базы: Debian 13 + Cinnamon 6.4 + slick-greeter.

[x.dm.slick-greeter]
theme-name='Mint-Y-Dark'
icon-theme-name='Mint-Y'
font-name='Ubuntu 11'
background='/usr/share/backgrounds/greenlinux/default_background.jpg'
draw-user-backgrounds=true
cursor-theme-name='Yaru'
cursor-theme-size=24

[org.blueman.general]
symbolic-status-icons=true

[org.gnome.desktop.interface]
cursor-theme='Yaru'
document-font-name='Sans 10'
font-name='Ubuntu 10'
gtk-theme='Mint-Y-Dark'
icon-theme='Mint-Y'
monospace-font-name='Monospace 10'
toolkit-accessibility=false

[org.gnome.desktop.background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/greenlinux/default_background.jpg'
primary-color='#000000'
secondary-color='#000000'
show-desktop-icons=false

[org.gnome.desktop.wm.preferences]
button-layout=':minimize,maximize,close'
num-workspaces=4
titlebar-font='Ubuntu Medium 10'
titlebar-uses-system-font=false

[org.gnome.desktop.sound]
event-sounds=false
input-feedback-sounds=false
theme-name='LinuxMint'

[org.gnome.libgnomekbd.keyboard]
options=['grp\tgrp:alt_shift_toggle', 'terminate\tterminate:ctrl_alt_bksp']

[org.cinnamon.desktop.interface]
cursor-theme='Yaru'
gtk-theme='Mint-Y-Dark'
icon-theme='Mint-Y'
menus-have-icons=true
toolkit-accessibility=false
font-name='Ubuntu 10'
scaling-factor=uint32 0

[org.cinnamon.desktop.screensaver]
font-date='Ubuntu 24'
font-message='Ubuntu 14'
font-time='Ubuntu 64'

[org.cinnamon.desktop.background]
primary-color='#000000'
secondary-color='#000000'
color-shading-type='solid'
picture-uri='file:///usr/share/backgrounds/greenlinux/default_background.jpg'
picture-options='zoom'

[org.cinnamon.desktop.wm.preferences]
button-layout=':minimize,maximize,close'
num-workspaces=4
titlebar-font='Ubuntu Medium 10'
titlebar-uses-system-font=false

[org.cinnamon.settings-daemon.plugins.xsettings]
hinting='slight'
menus-have-icons=true

[org.cinnamon.settings-daemon.plugins.power]
button-power='interactive'
lock-on-suspend=true

[org.cinnamon.theme]
name='Mint-Y-Dark'

[org.cinnamon]
panel-scale-text-icons=true
workspace-expo-view-as-grid=true
app-menu-icon-name='linuxmint-logo-ring-symbolic'
system-icon='linuxmint-logo-ring-symbolic'

[org.cinnamon.sounds]
login-file='/usr/share/mint-artwork/sounds/login.oga'
logout-file='/usr/share/mint-artwork/sounds/logout.ogg'
notification-file='/usr/share/mint-artwork/sounds/notification.oga'
plug-file='/usr/share/mint-artwork/sounds/plug.oga'
switch-file='/usr/share/mint-artwork/sounds/switch.oga'
tile-file='/usr/share/mint-artwork/sounds/tile.oga'
unplug-file='/usr/share/mint-artwork/sounds/unplug.oga'
close-enabled=false
login-enabled=true
logout-enabled=true
map-enabled=false
maximize-enabled=false
minimize-enabled=false
notification-enabled=true
plug-enabled=true
switch-enabled=true
tile-enabled=true
unmaximize-enabled=false
unplug-enabled=true

[org.cinnamon.desktop.sound]
event-sounds=false
input-feedback-sounds=false
theme-name='LinuxMint'
volume-sound-enabled=true
volume-sound-file='/usr/share/mint-artwork/sounds/volume.oga'

[org.cinnamon.desktop.session]
session-manager-uses-logind=true
settings-daemon-uses-logind=true

[org.nemo.desktop]
computer-icon-visible=false
home-icon-visible=false
network-icon-visible=false
trash-icon-visible=false
font='Ubuntu 10'
volumes-visible=true

[org.nemo.window-state]
start-with-status-bar=true

[org.nemo.preferences]
thumbnail-limit=34359738368

[org.gtk.Settings.FileChooser]
sort-directories-first=true
startup-mode='cwd'

[io.github.celluloid-player.Celluloid]
mpv-options='hwdec=yes'
